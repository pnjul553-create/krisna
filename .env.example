# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Opsional - jika dikosongkan, sistem otomatis menggunakan database SQLite lokal bawaan)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# JWT_SECRET: Secret key untuk sesi autentikasi lokal
JWT_SECRET="smk-prima-unggul-local-secret-change-in-production"
